[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/recipe_row.gd" id="1_row"]

[node name="RecipeRow" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1_row")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 14

[node name="Row" type="HBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Icon" type="TextureRect" parent="Margin/Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 120)
layout_mode = 2
expand_mode = 1
stretch_mode = 5

[node name="Text" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
theme_override_font_sizes/font_size = 38
text = "Rezept"

[node name="Info" type="Label" parent="Margin/Row/Text"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "2 Erz → 1 Barren"
autowrap_mode = 3

[node name="Progress" type="ProgressBar" parent="Margin/Row/Text"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 22)
layout_mode = 2
max_value = 1.0
step = 0.001
show_percentage = false

[node name="Buttons" type="VBoxContainer" parent="Margin/Row"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 8

[node name="StartButton" type="Button" parent="Margin/Row/Buttons"]
